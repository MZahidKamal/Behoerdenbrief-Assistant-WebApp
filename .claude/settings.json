{
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git commit --no-verify*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push origin main*)",
      "PowerShell(git commit --no-verify*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(uv run ruff check*)",
      "Bash(uv run ruff format --check*)",
      "Bash(uv run mypy*)",
      "Bash(uv run pytest*)",
      "Bash(npm run lint*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npm run test*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(uv run ruff check*)",
      "PowerShell(uv run ruff format --check*)",
      "PowerShell(uv run mypy*)",
      "PowerShell(uv run pytest*)",
      "PowerShell(npm run lint*)",
      "PowerShell(npx tsc --noEmit*)",
      "PowerShell(npm run test*)"
    ]
  }
}
