# Settings of the backend (API and worker). ARCHITECTURE §11.1.
# Copy this file to `server_side/.env` and fill in the values.
# Never commit `.env`. It can hold secrets (SECURITY §13).
# An empty value counts as missing.

# Required. Where the app runs: development, test or production.
APP_ENV=

# Optional. Lowest log level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
# Default: INFO.
LOG_LEVEL=

FRONTEND_BASE_URL=
CORS_ALLOWED_ORIGINS=

MAX_UPLOAD_REQUEST_MB=

SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATABASE_URL=

